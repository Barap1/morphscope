# Provider credentials are only needed for local, provider-backed experiments.
MORPH_API_KEY=
GROQ_API_KEY=
# Keep the default fixed for controlled MorphScope comparisons.
GROQ_MODEL=openai/gpt-oss-120b

# Local trace and artifact storage directory.
MORPHSCOPE_DATA_DIR=./.morphscope-data

# The public dashboard remains snapshot-backed. These server-only variables enable the
# authenticated workspace record manager; they do not enable provider execution.
MORPHSCOPE_HOSTED_READ_ONLY=true

# Authenticated workspace data (required together for hosted CRUD).
DATABASE_URL=
MORPHSCOPE_SESSION_SECRET=
# Generate with: pnpm workspace:auth-hash
MORPHSCOPE_WORKSPACE_PASSWORD_HASH=
