{
  "name": "morphscope",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "workspace:verify": "node scripts/verify-workspace.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
